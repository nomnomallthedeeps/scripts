# Tastea - searchable ingredient reference and blend builder.
# Version: 1.0.2
# Data source: published Google Sheets CSV (Maintained by Jocasta).
# Research of ingredients and table maintenance by Jocasta
# Base table created by Vannah
# Scripting by Tenaro

require 'csv'
require 'net/http'
require 'uri'

TASTEA_CSV_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vTnb0tM8p9aFELyaN-EC64HiROaAdRxsf40eHpq0hY6yh8o8esD0UgaQKg7AwKLU4gBPlRj6uRq2ce3/pub?gid=495361548&single=true&output=csv'
TASTEA_BASES_CSV_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vTnb0tM8p9aFELyaN-EC64HiROaAdRxsf40eHpq0hY6yh8o8esD0UgaQKg7AwKLU4gBPlRj6uRq2ce3/pub?gid=652566581&single=true&output=csv'
TASTEA_DATA_DIR = defined?(DATA_DIR) ? DATA_DIR : File.dirname(__FILE__)
TASTEA_CACHE_FILE = File.join(TASTEA_DATA_DIR, 'tastea_master.csv')
TASTEA_BASES_CACHE_FILE = File.join(TASTEA_DATA_DIR, 'tastea_bases.csv')

# Download the published CSV while identifying the request as a browser.
# Follow Google's publication redirects, including redirects to the CSV host.
def tastea_fetch_csv(uri, redirects = 0)
  raise 'Too many redirects while downloading the Tastea spreadsheet.' if redirects > 8

  request = Net::HTTP::Get.new(uri.request_uri)
  request['User-Agent'] = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0.0.0 Safari/537.36'
  request['Accept'] = 'text/csv,text/plain,application/octet-stream,*/*'
  request['Cache-Control'] = 'no-cache'

  response = Net::HTTP.start(
    uri.host,
    uri.port,
    use_ssl: uri.scheme == 'https',
    open_timeout: 15,
    read_timeout: 30
  ) do |http|
    http.request(request)
  end

  if response.is_a?(Net::HTTPRedirection)
    location = response['location']
    raise 'The spreadsheet redirected without a destination.' if location.nil? || location.empty?

    next_uri = URI.join(uri.to_s, location)
    return tastea_fetch_csv(next_uri, redirects + 1)
  end

  unless response.is_a?(Net::HTTPSuccess)
    raise "Spreadsheet download failed: HTTP #{response.code} #{response.message}"
  end

  body = response.body.to_s.force_encoding(Encoding::UTF_8)
  raise 'The spreadsheet returned an empty response.' if body.strip.empty?
  raise 'Google returned a sign-in page instead of CSV data.' if body.include?('ServiceLogin') || body.include?('<html')

  body
end

# Normalize rows into a distinct ingredient list. Repeated ingredient names
# are merged, regardless of Category; Category is not part of the user-facing
# selection.
def tastea_parse_csv(csv_text)
  table = CSV.parse(csv_text, headers: true)
  headers = table.headers.map { |header| header.to_s.sub(/\A\uFEFF/, '').strip.downcase }

  required = %w[category name scent taste]
  missing = required - headers
  raise "CSV is missing required column(s): #{missing.join(', ')}" unless missing.empty?

  indexes = {}
  required.each { |header| indexes[header] = headers.index(header) }

  ingredients = []
  ingredient_lookup = {}
  accepted_rows = 0
  skipped_rows = 0
  distinct_values = { 'category' => {}, 'scent' => {}, 'taste' => {} }

  table.each do |row|
    raw_name = row[indexes['name']].to_s.strip
    if raw_name.empty?
      skipped_rows += 1
      next
    end

    # Numbered rows are variants: (1) supplies X; (2) supplies Y.
    # Unnumbered legacy rows are treated as variant 1 until numbered.
    match = raw_name.match(/\A(.+?)\s*\(([12])\)\s*\z/)
    name = match ? match[1].strip : raw_name
    variant = match ? match[2].to_i : 1
    key = name.downcase

    ingredient = ingredient_lookup[key]
    unless ingredient
      ingredient = {
        name: name,
        categories: [],
        variants: {},
        scent: [],
        taste: []
      }
      ingredient_lookup[key] = ingredient
      ingredients << ingredient
    end

    category = row[indexes['category']].to_s.strip
    distinct_values['category'][category.downcase] = true unless category.empty?
    unless category.empty? || ingredient[:categories].any? { |existing| existing.casecmp(category).zero? }
      ingredient[:categories] << category
    end

    variant_data = ingredient[:variants][variant] ||= {
      scent: [], taste: []
    }

    %w[scent taste].each do |field|
      value = row[indexes[field]].to_s.strip
      next if value.empty?

      distinct_values[field][value.downcase] = true
      field_key = field.to_sym
      variant_data[field_key] << value unless variant_data[field_key].include?(value)
      ingredient[field_key] << value unless ingredient[field_key].include?(value)
    end

    accepted_rows += 1
  end

  {
    ingredients: ingredients,
    categories: ingredients.flat_map { |ingredient| ingredient[:categories] }.uniq.sort_by(&:downcase),
    distinct_categories: distinct_values['category'].length,
    accepted_rows: accepted_rows,
    skipped_rows: skipped_rows,
    distinct_names: ingredients.length,
    distinct_scents: distinct_values['scent'].length,
    distinct_tastes: distinct_values['taste'].length
  }
end

# Parse the Bases tab. A drink type is eligible only when BOTH templates
# contain standalone X and Y placeholders; incomplete templates are ignored.
def tastea_parse_bases_csv(csv_text)
  table = CSV.parse(csv_text, headers: true)
  headers = table.headers.map { |header| header.to_s.sub(/\A\uFEFF/, '').strip.downcase }
  required = ['drink type', 'scent', 'taste']
  missing = required - headers
  raise "Bases CSV is missing required column(s): #{missing.join(', ')}" unless missing.empty?

  indexes = {}
  required.each { |header| indexes[header] = headers.index(header) }
  bases = []
  skipped = 0
  distinct_values = { 'drink type' => {}, 'scent' => {}, 'taste' => {} }

  table.each do |row|
    drink_type = row[indexes['drink type']].to_s.strip
    scent = row[indexes['scent']].to_s.strip
    taste = row[indexes['taste']].to_s.strip

    distinct_values['drink type'][drink_type.downcase] = true unless drink_type.empty?
    distinct_values['scent'][scent.downcase] = true unless scent.empty?
    distinct_values['taste'][taste.downcase] = true unless taste.empty?

    if drink_type.empty? || scent.empty? || taste.empty? ||
       !scent.match?(/\bX\b/i) || !scent.match?(/\bY\b/i) ||
       !taste.match?(/\bX\b/i) || !taste.match?(/\bY\b/i)
      skipped += 1
      next
    end

    bases << { name: drink_type, scent: scent, taste: taste }
  end

  {
    bases: bases,
    skipped_rows: skipped,
    distinct_drinks: distinct_values['drink type'].length,
    distinct_scents: distinct_values['scent'].length,
    distinct_tastes: distinct_values['taste'].length
  }
end

# Fetch the Master Tea List and Bases concurrently. Previously these two network requests
# ran one after the other, doubling the time spent waiting on Google redirects.
tastea_load_source = lambda do |url, cache_file, parser|
  begin
    csv = tastea_fetch_csv(URI(url))
    data = parser.call(csv)
    begin
      File.write(cache_file, csv)
    rescue StandardError
      # A cache write failure should not prevent use of live spreadsheet data.
    end
    [data, 'Live spreadsheet', nil]
  rescue StandardError => download_error
    begin
      if File.file?(cache_file)
        data = parser.call(File.read(cache_file, encoding: 'UTF-8'))
        [data, 'Saved cache (spreadsheet unavailable)', download_error.message]
      else
        [nil, nil, download_error.message]
      end
    rescue StandardError => cache_error
      [nil, nil, "#{download_error.message}; cache: #{cache_error.message}"]
    end
  end
end

tastea_master_thread = Thread.new do
  tastea_load_source.call(TASTEA_CSV_URL, TASTEA_CACHE_FILE, method(:tastea_parse_csv))
end
tastea_bases_thread = Thread.new do
  tastea_load_source.call(TASTEA_BASES_CSV_URL, TASTEA_BASES_CACHE_FILE, method(:tastea_parse_bases_csv))
end

tastea_data, tastea_data_source, tastea_download_error = tastea_master_thread.value
tastea_bases_data, tastea_bases_source, tastea_bases_error = tastea_bases_thread.value
tastea_bases_data ||= { bases: [], skipped_rows: 0 }

unless tastea_data && !tastea_data[:ingredients].empty?
  message = tastea_download_error ?
    "Tastea couldn't load the spreadsheet (#{tastea_download_error}) and no usable cache was found." :
    'Tastea: The spreadsheet contains no usable ingredient rows.'
  respond message
  exit
end

unless defined?(Gtk) && Gtk::Version::MAJOR == 3
  respond 'Tastea: This version requires the GTK 3 interface available in Lich 5.'
  exit
end

# One case-insensitive, distinct ingredient list is shared by all selectors.
# Blank-search browsing is paged to keep GTK responsive; text searches show
# every matching result and open the result dropdown automatically.
tastea_ingredients = tastea_data[:ingredients].sort_by { |ingredient| ingredient[:name].downcase }
TASTEA_DROPDOWN_PAGE_SIZE = 50

tastea_finished = false
tastea_window_open = false
tastea_window = nil

Gtk.queue do
  tastea_window = Gtk::Window.new(:toplevel)
  tastea_window.set_title('Tastea')
  tastea_window.set_default_size(900, 780)
  tastea_window.set_border_width(12)
  tastea_window_open = true

  root = Gtk::Box.new(:vertical, 10)
  tastea_window.add(root)

  category_row = Gtk::Box.new(:horizontal, 8)
  category_label = Gtk::Label.new('Category (optional):')
  category_label.halign = Gtk::Align::START
  category_row.pack_start(category_label, false, false, 0)
  category_combo = Gtk::ComboBoxText.new
  category_combo.append_text('All Categories')
  tastea_data[:categories].each { |category| category_combo.append_text(category) }
  category_combo.active = 0
  category_combo.hexpand = true
  category_row.pack_start(category_combo, true, true, 0)
  root.pack_start(category_row, false, false, 0)

  blend_frame = Gtk::Frame.new('Blend Builder')
  blend_box = Gtk::Box.new(:vertical, 8)
  blend_box.set_border_width(10)
  blend_frame.add(blend_box)
  root.pack_start(blend_frame, true, true, 0)

  blend_grid = Gtk::Grid.new
  blend_grid.row_spacing = 7
  blend_grid.column_spacing = 10
  blend_box.pack_start(blend_grid, false, false, 0)

  # Each selector combines category and name filtering. Blank-search browsing
  # is paged in groups of 50; typing searches the complete filtered list.
  make_ingredient_selector = lambda do |caption, row, variant|
    label = Gtk::Label.new(caption)
    label.halign = Gtk::Align::START
    blend_grid.attach(label, 0, row, 1, 1)

    search = Gtk::Entry.new
    search.placeholder_text = 'Type to search ingredients...'
    search.hexpand = true
    blend_grid.attach(search, 1, row, 1, 1)

    # Live suggestions use Gtk::EntryCompletion so keyboard focus stays in
    # the search entry instead of moving to a separately opened combo popup.
    completion_model = Gtk::ListStore.new(String)
    completion = Gtk::EntryCompletion.new
    completion.model = completion_model
    completion.text_column = 0
    completion.minimum_key_length = 1
    completion.popup_completion = true
    completion.popup_set_width = true
    completion.set_match_func do |_entry_completion, _key, _iter|
      # Tastea has already applied category and substring filtering.
      true
    end
    search.completion = completion

    combo = Gtk::ComboBoxText.new
    combo.hexpand = true
    blend_grid.attach(combo, 2, row, 1, 1)

    state = { choices: [], selected: nil, updating: false, page: 0, has_more: false }
    refresh = lambda do |open_results = false|
      query = search.text.to_s.strip.downcase
      category = category_combo.active_text.to_s
      matching = tastea_ingredients.select do |ingredient|
        name_matches = query.empty? || ingredient[:name].downcase.include?(query)
        category_matches = category == 'All Categories' ||
          ingredient[:categories].any? { |item| item.casecmp(category).zero? }
        name_matches && category_matches && ingredient[:variants].key?(variant)
      end

      if query.empty?
        offset = state[:page] * TASTEA_DROPDOWN_PAGE_SIZE
        choices = matching.slice(offset, TASTEA_DROPDOWN_PAGE_SIZE) || []
        state[:has_more] = matching.length > offset + choices.length
      else
        choices = matching
        state[:has_more] = false
      end

      # Keep an existing selection visible even when a category or search
      # filter no longer matches it. The selection remains valid for the blend.
      selected_ingredient = if state[:selected]
        tastea_ingredients.find do |ingredient|
          ingredient[:name].casecmp(state[:selected][:name]).zero? && ingredient[:variants].key?(variant)
        end
      end
      if selected_ingredient && !choices.any? { |ingredient| ingredient[:name].casecmp(selected_ingredient[:name]).zero? }
        choices = [selected_ingredient] + choices
      end
      state[:choices] = choices

      # Keep live completion suggestions synchronized with filtered choices.
      completion_model.clear
      state[:choices].each do |ingredient|
        iter = completion_model.append
        iter[0] = ingredient[:name]
      end

      state[:updating] = true
      combo.remove_all
      state[:choices].each { |ingredient| combo.append_text(ingredient[:name]) }
      combo.append_text('Show next 50...') if state[:has_more]
      selected_index = state[:selected] ? state[:choices].index do |ingredient|
        ingredient[:name].casecmp(state[:selected][:name]).zero?
      end : nil
      combo.active = selected_index || -1
      state[:updating] = false
    end

    # Selecting an EntryCompletion suggestion must also update the selector's
    # actual saved choice and its visible ComboBox selection. Completion only
    # fills the search entry by itself; it does not select the ComboBox row.
    completion.signal_connect('match-selected') do |_entry_completion, model, iter|
      chosen_name = model.get_value(iter, 0).to_s
      ingredient = tastea_ingredients.find do |item|
        item[:name].casecmp(chosen_name).zero? && item[:variants].key?(variant)
      end

      if ingredient
        variant_data = ingredient[:variants][variant]
        state[:selected] = {
          name: ingredient[:name],
          scent: variant_data[:scent],
          taste: variant_data[:taste],
          variant: variant
        }
        refresh.call
        selected_index = state[:choices].index do |item|
          item[:name].casecmp(ingredient[:name]).zero?
        end
        combo.active = selected_index || -1
      end
      true
    end

    search.signal_connect('changed') do
      state[:page] = 0
      refresh.call
      # Ask GTK to display suggestions for the current search text.
      completion.complete unless search.text.to_s.strip.empty?
    end
    combo.signal_connect('changed') do
      unless state[:updating]
        index = combo.active
        if state[:has_more] && index == state[:choices].length
          state[:page] += 1
          refresh.call(true)
        else
          ingredient = index >= 0 ? state[:choices][index] : nil
          if ingredient
            variant_data = ingredient[:variants][variant]
            state[:selected] = {
              name: ingredient[:name],
              scent: variant_data[:scent],
              taste: variant_data[:taste],
              variant: variant
            }
          else
            state[:selected] = nil
          end
        end
      end
    end

    refresh.call
    [search, combo, state, refresh]
  end

  ingredient_one_search, ingredient_one_combo, ingredient_one_state, refresh_ingredient_one =
    make_ingredient_selector.call('Ingredient 1 (X):', 0, 1)
  ingredient_two_search, ingredient_two_combo, ingredient_two_state, refresh_ingredient_two =
    make_ingredient_selector.call('Ingredient 2 (Y):', 1, 2)

  category_combo.signal_connect('changed') do
    # Changing the shared category filter must not discard either selection.
    # Refresh keeps each selected ingredient visible even outside this category.
    [ingredient_one_state, ingredient_two_state].each { |state| state[:page] = 0 }
    refresh_ingredient_one.call
    refresh_ingredient_two.call
  end

  base_combo = Gtk::ComboBoxText.new
  tastea_bases_data[:bases].each { |base| base_combo.append_text(base[:name]) }
  base_combo.active = -1
  blend_grid.attach(Gtk::Label.new('Drink Type:'), 0, 2, 1, 1)
  blend_grid.attach(base_combo, 1, 2, 2, 1)

  preview_frame = Gtk::Frame.new('Blend Preview')
  preview_box = Gtk::Box.new(:vertical, 5)
  preview_box.set_border_width(8)
  preview_frame.add(preview_box)
  blend_box.pack_start(preview_frame, true, true, 0)

  blend_preview_labels = {}
  [['Scent', :scent], ['Taste', :taste]].each do |caption, key|
    heading = Gtk::Label.new("<b>#{caption}</b>")
    heading.use_markup = true
    heading.halign = Gtk::Align::START
    preview_box.pack_start(heading, false, false, 0)
    value = Gtk::Label.new('Select both ingredients and a drink type to preview the blend.')
    value.halign = Gtk::Align::START
    value.set_margin_start(18)
    value.set_line_wrap(true)
    value.set_selectable(true)
    preview_box.pack_start(value, false, false, 0)
    blend_preview_labels[key] = value
  end

  blend_footer = Gtk::ButtonBox.new(:horizontal)
  blend_footer.layout = :end
  print_blend_button = Gtk::Button.new(label: 'Print Blend to Game')
  print_blend_button.sensitive = false
  blend_footer.add(print_blend_button)
  blend_box.pack_start(blend_footer, false, false, 0)

  footer = Gtk::ButtonBox.new(:horizontal)
  footer.layout = :end
  close_button = Gtk::Button.new(label: 'Close')
  footer.add(close_button)
  root.pack_start(footer, false, false, 0)

  # Source and distinct-column statistics are shown at the bottom of the GUI.
  ingredient_source_row = Gtk::Box.new(:horizontal, 4)
  ingredient_source_label = Gtk::Label.new('Ingredient Source:')
  ingredient_source_url = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vTnb0tM8p9aFELyaN-EC64HiROaAdRxsf40eHpq0hY6yh8o8esD0UgaQKg7AwKLU4gBPlRj6uRq2ce3/pub?gid=495361548'
  ingredient_source_link = Gtk::LinkButton.new(ingredient_source_url, 'Master Tea List')
  ingredient_stats = Gtk::Label.new(
    "| Categories: #{tastea_data[:distinct_categories]} | Ingredients: #{tastea_data[:distinct_names]} | Scents: #{tastea_data[:distinct_scents]} | Tastes: #{tastea_data[:distinct_tastes]}"
  )
  ingredient_source_row.pack_start(ingredient_source_label, false, false, 0)
  ingredient_source_row.pack_start(ingredient_source_link, false, false, 0)
  ingredient_source_row.pack_start(ingredient_stats, false, false, 0)
  root.pack_start(ingredient_source_row, false, false, 0)

  base_source_row = Gtk::Box.new(:horizontal, 4)
  base_source_label = Gtk::Label.new('Base Source:')
  base_source_url = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vTnb0tM8p9aFELyaN-EC64HiROaAdRxsf40eHpq0hY6yh8o8esD0UgaQKg7AwKLU4gBPlRj6uRq2ce3/pub?gid=652566581'
  base_source_link = Gtk::LinkButton.new(base_source_url, 'Bases')
  base_stats = Gtk::Label.new(
    "| Drinks: #{tastea_bases_data[:distinct_drinks]} | Scents: #{tastea_bases_data[:distinct_scents]} | Tastes: #{tastea_bases_data[:distinct_tastes]}"
  )
  base_source_row.pack_start(base_source_label, false, false, 0)
  base_source_row.pack_start(base_source_link, false, false, 0)
  base_source_row.pack_start(base_stats, false, false, 0)
  root.pack_start(base_source_row, false, false, 0)

  # Clicking either source link copies its URL instead of opening a browser.
  # A generation counter ensures an older timeout cannot hide a newer toast.
  toast_label = Gtk::Label.new('URL copied to clipboard')
  toast_label.halign = Gtk::Align::CENTER
  root.pack_start(toast_label, false, false, 0)
  toast_generation = 0

  copy_source_url = lambda do |url|
    Gtk::Clipboard.get(Gdk::Selection::CLIPBOARD).set_text(url)
    toast_generation += 1
    current_generation = toast_generation
    toast_label.text = 'URL copied to clipboard'
    toast_label.show
    GLib::Timeout.add(2000) do
      toast_label.hide if toast_generation == current_generation
      false
    end
    true
  end

  ingredient_source_link.signal_connect('activate-link') do
    copy_source_url.call(ingredient_source_url)
  end
  base_source_link.signal_connect('activate-link') do
    copy_source_url.call(base_source_url)
  end

  selected_blend = lambda do
    first = ingredient_one_state[:selected]
    second = ingredient_two_state[:selected]
    base = tastea_bases_data[:bases][base_combo.active] if base_combo.active >= 0
    first && second && base ? [first, second, base] : nil
  end

  build_blend = lambda do
    selection = selected_blend.call
    if selection
      first, second, base = selection
      first_scent = first[:scent].first || 'No scent description provided.'
      second_scent = second[:scent].first || 'No scent description provided.'
      first_taste = first[:taste].first || 'No taste description provided.'
      second_taste = second[:taste].first || 'No taste description provided.'
      scent = base[:scent].gsub(/\bX\b/i) { first_scent }.gsub(/\bY\b/i) { second_scent }
      taste = base[:taste].gsub(/\bX\b/i) { first_taste }.gsub(/\bY\b/i) { second_taste }
      blend_preview_labels[:scent].text = scent
      blend_preview_labels[:taste].text = taste
      print_blend_button.sensitive = true
      { first: first, second: second, base: base, scent: scent, taste: taste }
    else
      blend_preview_labels.each_value { |label| label.text = 'Select both ingredients and a drink type to preview the blend.' }
      print_blend_button.sensitive = false
      nil
    end
  end

  [ingredient_one_combo, ingredient_two_combo, base_combo].each do |combo|
    combo.signal_connect('changed') { build_blend.call }
  end
  category_combo.signal_connect('changed') { build_blend.call }

  print_blend_button.signal_connect('clicked') do
    blend = build_blend.call
    if blend
      divider = '============================================================'
      section = '------------------------------------------------------------'
      output = [
        divider,
        '                         TASTEA BLEND',
        divider,
        "DRINK TYPE : #{blend[:base][:name]}",
        section,
        "INGREDIENT 1 (X): #{blend[:first][:name]}",
        "INGREDIENT 2 (Y): #{blend[:second][:name]}",
        section,
        'SCENT',
        blend[:scent],
        section,
        'TASTE',
        blend[:taste],
        divider
      ].join("\n")
      respond(output)
    end
  end

  close_button.signal_connect('clicked') { tastea_window.destroy }
  tastea_window.signal_connect('destroy') do
    tastea_finished = true
    tastea_window_open = false
  end

  tastea_window.show_all
  toast_label.hide
  tastea_window.keep_above = true
end

before_dying do
  Gtk.queue { tastea_window.destroy if tastea_window_open && tastea_window }
end

sleep 0.1 until tastea_finished